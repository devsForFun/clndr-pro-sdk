# Server-side — never ship to the browser.
CLNDR_SECRET_KEY=clndr_sk_...

# Client-side — safe to embed in the frontend bundle.
NEXT_PUBLIC_CLNDR_PUBLISHABLE_KEY=clndr_pk_...

# Override if you run clndr.pro locally or self-host it. Defaults to
# https://www.clndr.pro (use the www host; the apex redirects and drops the
# Authorization header).
# NEXT_PUBLIC_CLNDR_BASE_URL=http://localhost:3000   # browser (ClndrProvider)
# CLNDR_BASE_URL=http://localhost:3000               # server (app/api/bookings)
