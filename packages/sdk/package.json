{
  "name": "@clndr-pro/sdk",
  "version": "0.1.4",
  "description": "TypeScript SDK for clndr.pro — booking pages, slots, and meetings.",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": ["dist", "README.md"],
  "repository": {
    "type": "git",
    "url": "https://github.com/clndr-pro/clndr-pro-sdk.git",
    "directory": "packages/sdk"
  },
  "bugs": "https://github.com/clndr-pro/clndr-pro-sdk/issues",
  "homepage": "https://github.com/clndr-pro/clndr-pro-sdk#readme",
  "keywords": ["clndr", "scheduling", "calendar", "booking", "sdk"],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
